<com.android.launcher3.folder.FolderIcon
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:focusable="true" >
    <!--
      LC-Fix: no paddingLeft/Right here. The label below already carries
      @dimen/dynamic_grid_cell_padding_x through style BaseIcon.AllApps, exactly like the
      BubbleTextView of an app cell; adding it again on the root made the folder label ~16dp
      narrower than an app label, so category names ellipsised one character earlier
      ("影音娛樂" -> "影..."). The icon preview is centred on getMeasuredWidth()
      (PreviewItemManager#computePreviewDrawingParams), so dropping the padding does not move it.
    -->
    <com.android.launcher3.views.DoubleShadowBubbleTextView
        style="@style/BaseIcon.AllApps"
        android:id="@+id/folder_icon_name"
        android:focusable="false"
        android:layout_gravity="top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:iconDisplay="all_apps"/>
</com.android.launcher3.folder.FolderIcon>
